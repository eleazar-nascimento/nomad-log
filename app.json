{
  "expo": {
    "name": "NomadLog - Diário e Despesas Offline",
    "slug": "nomad-log",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nomadlog",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./public/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nomadlog.app"
    },
    "android": {
      "package": "com.nomadlog.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./public/icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

