{
  "expo": {
    "name": "NomadLog - Diário e Despesas Offline",
    "slug": "nomad-log",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nomadlog",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./public/icon.png",
    "splash": {
      "image": "./public/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1115"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nomadlog.app"
    },
    "android": {
      "package": "com.nomadlog.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./public/icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2bcb99b3-3e24-4e6b-a044-222fbe0c4256"
      }
    },
    "owner": "eleazar.nascimento"
  }
}
