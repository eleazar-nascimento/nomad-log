{
  "name": "nomad-log",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "TMPDIR=/tmp expo start",
    "android": "TMPDIR=/tmp expo start --android",
    "ios": "TMPDIR=/tmp expo start --ios",
    "web": "TMPDIR=/tmp expo start --web",
    "build:apk": "EAS_BUILD_SKIP_LOCKFILE_CHECK=1 npx eas-cli build --platform android --profile preview",
    "build:aab": "EAS_BUILD_SKIP_LOCKFILE_CHECK=1 npx eas-cli build --platform android --profile production",
    "build:ios": "EAS_BUILD_SKIP_LOCKFILE_CHECK=1 npx eas-cli build --platform ios --profile preview",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.2.3",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "clsx": "^2.1.1",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^0.468.0",
    "nativewind": "^4.2.7",
    "query-string": "^7.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "1.27.0",
    "lightningcss-linux-arm64-gnu": "1.27.0",
    "lightningcss-linux-x64-gnu": "1.27.0"
  },
  "private": true
}
